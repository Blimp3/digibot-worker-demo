{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "digibot-worker-synthetic-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "INTEGRATION_ENABLED": "false",
    "INTEGRATION_ALLOWED_ORIGINS": "chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "PUBLIC_WORKER_BASE_URL": "https://worker.example.invalid",
    "TELEGRAM_BOT_API_BASE": "https://api.telegram.org",
    "R2_BUCKET_NAME": "demo-media",
    "R2_ENDPOINT": "https://account-id.r2.cloudflarestorage.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "demo-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "demo-media" }
  ],
  "services": [
    {
      "binding": "PROVENANCE_VERIFIER",
      "service": "provenance-demo",
      "entrypoint": "IntegrationVerifier"
    }
  ]
}
